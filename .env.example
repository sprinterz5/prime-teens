# Local dev Postgres started via `docker compose up -d` (see docker-compose.yml).
# Credentials below are obviously-fake dev-only values, not real secrets.
DATABASE_URL="postgresql://primeteens:primeteens_dev_password@localhost:5432/primeteens?schema=public"
NEXT_PUBLIC_SITE_URL="https://primeteens.kz"

# Session cookie signing secret (HMAC-SHA256). Generate a random value per env,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SESSION_SECRET=

# Telegram bot tokens, copied from bot/.env (BOT_TOKEN -> mentor, KIDS_BOT_TOKEN -> kids/students).
# Used server-side only, to verify Telegram Mini App initData.
TELEGRAM_MENTOR_BOT_TOKEN=
TELEGRAM_KIDS_BOT_TOKEN=

# Set to 1 to enable /dev/login (also requires NODE_ENV !== production). Never set in production.
DEV_LOGIN=0
