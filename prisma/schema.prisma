generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: this schema covers only what the marketing/portal web app (apps/web)
// owns directly: portal login and the site's own lead capture. The full CRM
// domain (Deal, Contract, Payment, CuratorAssignment, Task, messaging, AI
// summaries) is designed in PLAN.md §6 and belongs to the future Spring Boot
// service (apps/api) — it is not modeled here to avoid two systems of record
// for the same tables.

enum Role {
  ADMIN
  SALES
  CURATOR
  PARENT
  STUDENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum LeadStatus {
  NEW
  CONTACTED
  ASSESSMENT_PAID
  ASSESSMENT_DONE
  PROPOSAL_SENT
  CONTRACT_SENT
  WON
  LOST
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  phone         String?
  passwordHash  String?
  oauthId       String?
  role          Role       @default(STUDENT)
  status        UserStatus @default(INVITED)
  locale        String     @default("ru")
  assignedLeads Lead[]     @relation("LeadAssignedSales")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
}

model Lead {
  id              String     @id @default(cuid())
  name            String
  contact         String // phone or email
  role            String     @default("parent") // parent | student
  interest        String     @default("assessment") // assessment | consultation | program
  source          String     @default("site_form") // instagram | telegram_ads | site_form
  status          LeadStatus @default(NEW)
  consent         Boolean
  locale          String     @default("ru")
  assignedSalesId String?
  assignedSales   User?      @relation("LeadAssignedSales", fields: [assignedSalesId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
}

// ---------------------------------------------------------------------------
// Course platform (workbook + mentor bot) — shared with the Python Telegram
// bot in bot/, which reads/writes these same tables via plain asyncpg SQL.
// Prisma owns the schema/migrations; table and column names are pinned to
// the bot's existing SQLite names (bot/app/schema.sql + _migrate() in
// bot/app/db.py) via @@map/@map so the bot's raw SQL keeps working unchanged
// apart from the type adjustments called out below (bool vs 0/1, BigInt tg
// ids, real Date/Timestamptz instead of TEXT).
// ---------------------------------------------------------------------------

model Group {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  startDate  DateTime? @map("start_date") @db.Date
  lessonTime String?   @map("lesson_time")
  shift      String    @default("evening")
  format     String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // «Завершить поток» (see PLAN in the archive-group feature): once set, every
  // workbook write for this group's students is refused (409) and the
  // workbook client renders read-only. Set either by an admin (manual, e.g.
  // to close a stream early) or automatically by the bot's archive-lock job
  // (bot/app/scheduler.py:archive_lock) once the course's last day
  // (hackathon) is over — see bot/app/db.py:_group_finished, the single
  // source of truth for "is this group's course over".
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  // Set by "Вернуть в работу" (admin unarchive) and never cleared again by
  // anything except another manual archive. Stops the bot's auto-lock job
  // from re-archiving a group an admin deliberately reopened.
  archiveReopened Boolean @default(false) @map("archive_reopened")
  // Planned/actual end of the course's last day, kept fresh by the bot's
  // archive-lock job (bot/app/db.py:group_lesson_window) every ~5 minutes.
  // Powers the mentor dashboard's "closes at" hint before the group is
  // actually archived. Null until the bot has computed it at least once
  // (e.g. group has no start_date yet).
  endsAt DateTime? @map("ends_at") @db.Timestamptz(6)

  students      Student[]
  kidFeedback   KidFeedback[]
  rosterEntries Roster[]
  mentorGroups  MentorGroup[]
  sessions      Session[]
  invites       Invite[]
  liveSessions  LiveSession[]

  @@map("groups")
}

model Student {
  id          Int     @id @default(autoincrement())
  groupId     Int     @map("group_id")
  fullName    String  @map("full_name")
  shortName   String? @map("short_name")
  classSchool String? @map("class_school")
  team        String?
  phone       String?
  tgUserId    BigInt? @unique @map("tg_user_id")
  active      Boolean @default(true)

  group              Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kidFeedback        KidFeedback[]
  hackTeamsLed       HackTeam[]        @relation("HackTeamLeader")
  hackTeamMembership HackTeamMember[]
  answers            Answer[]
  characteristics    Characteristic[]
  invites            Invite[]
  workbookEntries    WorkbookEntry[]
  workbookDrawings   WorkbookDrawing[]
  homework           Homework[]
  loginCodes         LoginCode[]
  liveAnswers        LiveAnswer[]

  @@unique([groupId, fullName])
  @@map("students")
}

// Отзывы учеников о занятии — детский бот. Анонимны ПО ПОЛИТИКЕ: student_id
// хранится, но ни один экран для менторов/админа не должен присоединять имя
// ученика к тексту отзыва (см. group_kid_feedback в bot/app/db.py).
model KidFeedback {
  id        Int      @id @default(autoincrement())
  studentId Int      @map("student_id")
  groupId   Int      @map("group_id")
  dayIndex  Int      @map("day_index")
  rating    Int?
  text      String?
  source    String   @default("text")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, dayIndex], map: "idx_kid_feedback_group_day")
  @@map("kid_feedback")
}

model HackTeam {
  id        Int      @id @default(autoincrement())
  name      String
  caseName  String?  @map("case_name")
  leaderId  Int      @map("leader_id")
  joinCode  String   @unique @map("join_code")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  leader  Student          @relation("HackTeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members HackTeamMember[]

  @@map("hack_teams")
}

model HackTeamMember {
  teamId    Int      @map("team_id")
  studentId Int      @map("student_id")
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  team    HackTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([teamId, studentId])
  @@map("hack_team_members")
}

// Белый список телефонов: кто имеет право зарегистрироваться ментором.
model Roster {
  phone    String  @id
  fullName String  @map("full_name")
  groupId  Int?    @map("group_id")
  isAdmin  Boolean @default(false) @map("is_admin")
  isMentor Boolean @default(true) @map("is_mentor")
  // Курс-директор: правит задания live-режима и видит все группы. Между
  // ментором и админом; выдаётся так же, как админ (bot/app/db.py:grant_director).
  isDirector Boolean @default(false) @map("is_director")

  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@map("roster")
}

model Mentor {
  id        Int      @id @default(autoincrement())
  tgUserId  BigInt   @unique @map("tg_user_id")
  phone     String?
  fullName  String?  @map("full_name")
  isAdmin   Boolean  @default(false) @map("is_admin")
  isMentor  Boolean  @default(true) @map("is_mentor")
  // См. Roster.isDirector. Флаги независимы: курс-директор может вести и свою группу.
  isDirector Boolean @default(false) @map("is_director")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mentorGroups     MentorGroup[]
  sessions         Session[]
  homeworkReviewed Homework[]
  loginCodes       LoginCode[]
  liveActivities   LiveActivity[]
  liveSessions     LiveSession[]

  @@map("mentors")
}

model MentorGroup {
  mentorId Int @map("mentor_id")
  groupId  Int @map("group_id")

  mentor Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([mentorId, groupId])
  @@map("mentor_groups")
}

// Заполнение чек-листа за конкретный день
model Session {
  id         Int       @id @default(autoincrement())
  mentorId   Int       @map("mentor_id")
  groupId    Int       @map("group_id")
  dayIndex   Int       @map("day_index")
  kind       String    @default("lesson")
  status     String    @default("open")
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  mentor  Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([groupId, dayIndex, kind], map: "idx_sessions_group_day")
  @@map("sessions")
}

// Ответы. Один ряд = один ответ на один вопрос. group_id здесь без FK — так
// же, как в исходной schema.sql (см. комментарий там).
model Answer {
  id           Int      @id @default(autoincrement())
  sessionId    Int      @map("session_id")
  groupId      Int      @map("group_id")
  dayIndex     Int      @map("day_index")
  studentId    Int?     @map("student_id")
  questionKey  String   @map("question_key")
  questionText String?  @map("question_text")
  mapsTo       String?  @map("maps_to")
  value        String?
  text         String?
  source       String   @default("text")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId], map: "idx_answers_student")
  @@index([sessionId], map: "idx_answers_session")
  @@map("answers")
}

// Сгенерированные характеристики
model Characteristic {
  id        Int      @id @default(autoincrement())
  studentId Int      @map("student_id")
  payload   Json
  htmlPath  String?  @map("html_path")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("characteristics")
}

// Чтобы не слать одно и то же напоминание дважды
model Notification {
  key    String   @id
  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@map("notifications")
}

// Пригласительные ссылки (менторы/админы/ученики). created_by и used_by_tg
// хранят Telegram user id, а не FK на mentors.id — см. bot/app/db.py.
model Invite {
  token     String    @id
  groupId   Int       @map("group_id")
  studentId Int?      @map("student_id")
  role      String    @default("mentor")
  createdBy BigInt?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revoked   Boolean   @default(false)
  usedByTg  BigInt?   @map("used_by_tg")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("invites")
}

// ---------------------------------------------------------------------------
// Online workbook (Next.js platform only — the bot does not touch these).
// ---------------------------------------------------------------------------

model WorkbookEntry {
  studentId   Int      @map("student_id")
  fieldId     String   @map("field_id")
  value       Json
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedByTg BigInt?  @map("updated_by_tg")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, fieldId])
  @@index([updatedAt])
  @@map("workbook_entries")
}

model WorkbookDrawing {
  studentId Int      @map("student_id")
  fieldId   String   @map("field_id")
  filePath  String   @map("file_path")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, fieldId])
  @@map("workbook_drawings")
}

// ---------------------------------------------------------------------------
// Вход на платформу вне Telegram. Бот (/login в детском или менторском)
// пишет сюда одноразовую ссылку и короткий код; сайт меняет любой из них на
// обычную сессию (lib/auth/login-code.ts). Ссылка хранится только как
// sha256 — по содержимому таблицы войти нельзя. Новая выдача гасит старые
// неиспользованные коды того же человека (bot/app/db.py:issue_login_code).
// ---------------------------------------------------------------------------

model LoginCode {
  tokenHash String    @id @map("token_hash")
  code      String
  role      String // student | mentor (admin — это mentor с is_admin)
  studentId Int?      @map("student_id")
  mentorId  Int?      @map("mentor_id")
  tgUserId  BigInt    @map("tg_user_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentor  Mentor?  @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([code], map: "idx_login_codes_code")
  @@map("login_codes")
}

// Домашка: одна сдача на ученика и день курса (текст задания — homework дня
// в bot/config/course.yaml). Ученик сдаёт и правит на платформе, ментор
// принимает или возвращает с комментарием. notified_at ставит детский бот,
// когда сообщил ученику о проверке (bot/app/kids/scheduler.py); новая сдача
// сбрасывает и проверку, и notified_at.
model Homework {
  studentId     Int       @map("student_id")
  dayIndex      Int       @map("day_index")
  text          String
  status        String    @default("submitted") // submitted | accepted | returned
  mentorComment String?   @map("mentor_comment")
  submittedAt   DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy    Int?      @map("reviewed_by")
  notifiedAt    DateTime? @map("notified_at") @db.Timestamptz(6)

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer Mentor? @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@id([studentId, dayIndex])
  @@index([status], map: "idx_homework_status")
  @@map("homework")
}

// ---------------------------------------------------------------------------
// Live-режим (свой «Kahoot» на уроке, lib/live.ts). Шаблоны правит
// курс-директор; при запуске вопросы копируются в live_sessions.questions,
// так что правка шаблона не трогает уже собранные ответы. Ответы на
// экране — только обобщённо и в моменте; по ученикам их видит только ментор.
// ---------------------------------------------------------------------------

model LiveActivity {
  id         Int       @id @default(autoincrement())
  title      String
  dayIndex   Int?      @map("day_index") // к какому дню курса — подсказка при запуске
  createdBy  Int?      @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  author    Mentor?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  questions LiveQuestion[]
  sessions  LiveSession[]

  @@map("live_activities")
}

model LiveQuestion {
  id           Int    @id @default(autoincrement())
  activityId   Int    @map("activity_id")
  position     Int
  kind         String // choice | scale | text
  prompt       String
  options      Json   @default("[]") // варианты для choice
  correctIndex Int?   @map("correct_index") // choice с правильным ответом = квиз
  timeLimitSec Int?   @map("time_limit_sec")

  activity LiveActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, position], map: "idx_live_questions_activity")
  @@map("live_questions")
}

model LiveSession {
  id           Int       @id @default(autoincrement())
  activityId   Int?      @map("activity_id")
  groupId      Int       @map("group_id")
  startedBy    Int?      @map("started_by")
  title        String
  questions    Json // снимок вопросов шаблона на момент запуска
  currentIndex Int       @default(-1) @map("current_index") // -1 — лобби
  phase        String    @default("lobby") // lobby | open | reveal | finished
  openedAt     DateTime? @map("opened_at") @db.Timestamptz(6)
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)

  activity LiveActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  group    Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  starter  Mentor?       @relation(fields: [startedBy], references: [id], onDelete: SetNull)
  answers  LiveAnswer[]

  @@index([groupId, finishedAt], map: "idx_live_sessions_group")
  @@map("live_sessions")
}

model LiveAnswer {
  sessionId     Int      @map("session_id")
  questionIndex Int      @map("question_index")
  studentId     Int      @map("student_id")
  value         Json
  correct       Boolean?
  answeredAt    DateTime @default(now()) @map("answered_at") @db.Timestamptz(6)

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([sessionId, questionIndex, studentId])
  @@map("live_answers")
}
