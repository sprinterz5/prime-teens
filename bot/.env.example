# ================= Telegram =================
BOT_TOKEN=

# Telegram user_id первого админа (узнать: напиши боту /whoami)
ADMIN_IDS=

# ================= Детский бот =================
# Отдельный бот (app/kids/main.py), свой токен от @BotFather, запускается
# через "run.bat kids" или "run.bat both". KIDS_BOT_USERNAME — без @, нужен
# чтобы /invite -> Ссылки для учеников (в этом, менторском боте) собирал
# рабочие ссылки на детского бота.
KIDS_BOT_USERNAME=
KIDS_BOT_TOKEN=

# ================= Синхронизация с Google-таблицей =================
# Бот САМ забирает данные по расписанию — таблица публикуется как Web App
# (integrations/sheets_sync.gs), бот ходит по ссылке. Установка по шагам —
# integrations/README.md. Пусто — ни /sync_sheet, ни ночной автозабор
# ничего не делают.
#
# SHEETS_SYNC_URL   — ссылка вида https://script.google.com/macros/s/.../exec
#                     (Apps Script -> Deploy -> New deployment -> Web app)
# SHEETS_SYNC_TOKEN — та же случайная строка, что вписана в SHEET_SECRET
#                     внутри sheets_sync.gs — это НЕ токен бота, отдельный
#                     секрет только для доступа к этой ссылке
# SHEETS_SYNC_HOUR  — час ночного автозабора, 0-23 по времени бота (TZ ниже)
SHEETS_SYNC_URL=
SHEETS_SYNC_TOKEN=
SHEETS_SYNC_HOUR=3

# ================= Общее =================
TZ=Asia/Almaty

# Postgres, общий с веб-платформой (Next.js в корне репозитория) — схемой и
# миграциями владеет Prisma (prisma/schema.prisma, prisma/migrations/), бот сам
# ничего не создаёт и не мигрирует (см. app/db.py). Локально — тот же
# DATABASE_URL, что в корневом .env (`pnpm db:dev` или `docker compose up -d`).
DATABASE_URL=postgresql://primeteens:primeteens_dev_password@localhost:5432/primeteens
MEDIA_DIR=data/media
OUT_DIR=data/out

# ================= Распознавание речи =================
# faster_whisper    — локально, ничего не платим, нужен CPU/GPU
# openai_compatible — удалённый /v1/audio/transcriptions
# off               — голосовые не принимаем, только текст
STT_PROVIDER=faster_whisper

# для faster_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# для openai_compatible.
# У Alem эндпоинт /v1/audio/transcriptions есть, но ключ выдаётся под конкретные
# модели: ключ от qwen3-8 к нему не пускает. Нужен отдельный ключ с доступом к
# модели Speech-to-text (в каталоге есть обычная и казахская), её имя — в STT_MODEL.
STT_BASE_URL=https://llm.alem.ai/v1
STT_API_KEY=
STT_MODEL=

# ================= LLM =================
# Нужен только для экспериментальной автосборки характеристик.
# Выгрузка материалов (/export) работает вообще без модели.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://llm.alem.ai/v1
LLM_API_KEY=
LLM_MODEL=qwen3-8
LLM_TEMPERATURE=0.4
# qwen3-8 — reasoning-модель, часть бюджета уходит на скрытые размышления
LLM_MAX_TOKENS=10000

# ================= Эксперименты =================
# true — в меню появится «🧪 Характеристики»: модель пишет черновик по заметкам.
# Черновик всегда нужно перечитывать перед показом родителям.
EXPERIMENTAL_CHARACTERISTICS=false
